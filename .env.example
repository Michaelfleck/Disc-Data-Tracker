# ─── Database (Supabase) ─────────────────────────────────────────────────────
# Pooled connection (PgBouncer) — used at runtime
DATABASE_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:6543/postgres?pgbouncer=true"
# Direct connection — used by Prisma migrations only
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# ─── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ─── Google OAuth (console.cloud.google.com) ─────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Vercel Blob (vercel.com/dashboard → Storage → Blob) ─────────────────────
BLOB_READ_WRITE_TOKEN=""

# ─── AccuWeather (developer.accuweather.com) ─────────────────────────────────
ACCUWEATHER_API_KEY=""

# ─── PDGA (api.pdga.com) ─────────────────────────────────────────────────────
PDGA_USERNAME=""
PDGA_PASSWORD=""

# ─── Mapbox (account.mapbox.com) — NEXT_PUBLIC_ prefix exposes to browser ────
NEXT_PUBLIC_MAPBOX_TOKEN=""
