generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── NextAuth ──────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  handle        String?   @unique
  homeCity      String?
  level         Int       @default(1)
  xp            Int       @default(0)
  title         String?
  accounts      Account[]
  sessions      Session[]
  rounds        Round[]
  rivalries     Rivalry[]
  createdAt     DateTime  @default(now())
}

// ─── Courses & Layouts ────────────────────────────────────────────────────────

model Course {
  id      String   @id @default(cuid())
  name    String
  city    String?
  lat     Float?
  lng     Float?
  layouts Layout[]
  rounds  Round[]

  @@unique([name, city])
}

model Layout {
  id       String  @id @default(cuid())
  name     String
  holes    Int     @default(18)
  par      Int?
  course   Course  @relation(fields: [courseId], references: [id])
  courseId String
  rounds   Round[]

  @@unique([courseId, name])
}

// ─── Rounds ───────────────────────────────────────────────────────────────────

model Round {
  id          String      @id @default(cuid())
  userId      String
  courseId    String
  layoutId    String
  playerName  String
  playedAt    DateTime
  endedAt     DateTime?
  total       Int
  toPar       Int
  rating      Int?
  timeOfDay   TimeSlot    @default(AFTERNOON)
  isPB        Boolean     @default(false)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course      @relation(fields: [courseId], references: [id])
  layout      Layout      @relation(fields: [layoutId], references: [id])
  holeScores  HoleScore[]
  createdAt   DateTime    @default(now())

  @@index([userId, playedAt])
  @@index([courseId])
}

// ─── Hole Scores ──────────────────────────────────────────────────────────────

model HoleScore {
  id      String @id @default(cuid())
  roundId String
  hole    Int
  strokes Int
  par     Int?
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, hole])
}

// ─── Rivalries ────────────────────────────────────────────────────────────────

model Rivalry {
  id         String    @id @default(cuid())
  userId     String
  rivalName  String
  wins       Int       @default(0)
  losses     Int       @default(0)
  avgMargin  Float     @default(0)
  lastPlayed DateTime?
  user       User      @relation(fields: [userId], references: [id])

  @@unique([userId, rivalName])
}

enum TimeSlot {
  MORNING
  AFTERNOON
  EVENING
}
